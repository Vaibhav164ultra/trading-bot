# =============================================================================
# Zerodha Kite Connect Trading System — Environment Variables
# Copy this file to .env and fill in your credentials
# =============================================================================

# --- Kite Connect API (Get from https://developers.kite.trade/) ---
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=  # Optional: Set after login flow completion

# --- Trading Parameters ---
TRADING_MODE=paper  # paper | live
DEFAULT_QUANTITY=1
MAX_POSITIONS=5

# --- Risk Management ---
MAX_DAILY_LOSS_PCT=2      # Max daily loss as percentage of equity
MAX_POSITION_LOSS_PCT=1   # Max loss per position as percentage
STOP_LOSS_PCT=0.5         # Stop loss percentage
TARGET_PCT=1.5            # Target profit percentage

# --- Data & Analysis ---
DATA_DIR=./data
HISTORICAL_DAYS=365
TIMEFRAME=day  # minute | 5minute | 15minute | 30minute | 60minute | day

# --- Server ---
PORT=3000
LOG_LEVEL=info